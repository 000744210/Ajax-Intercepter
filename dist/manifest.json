{
  "author": "@samrum/vite-plugin-web-extension",
  "description": "A @samrum/vite-plugin-web-extension web extension",
  "name": "Vite Web Extension",
  "version": "1.0.0",
  "icons": {
    "16": "icons/16.png",
    "19": "icons/19.png",
    "32": "icons/32.png",
    "38": "icons/38.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "96": "icons/96.png",
    "128": "icons/128.png",
    "256": "icons/256.png",
    "512": "icons/512.png"
  },
  "content_scripts": [
    {
      "js": [
        "src/entries/contentScript/logger.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "permissions": [
    "<all_urls>",
    "*://*/*",
    "identity",
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "background": {
    "persistent": true,
    "page": "background.html"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/16.png",
      "19": "icons/19.png",
      "32": "icons/32.png",
      "38": "icons/38.png"
    },
    "default_popup": "src/entries/popup/index.html"
  },
  "host_permissions": [
    "<all_urls>",
    "*://*/*",
    "identity",
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "manifest_version": 2,
  "web_accessible_resources": [
    "assets/apiLogs-01d41536.js",
    "assets/chromeLocalStorage-9b4cabbc.js",
    "assets/pinia-d2e6537f.js",
    "assets/src/entries/contentScript/logger-02e47696.js"
  ]
}